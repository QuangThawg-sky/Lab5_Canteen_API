    {
      "name": "CSV Tests",
      "item": [
        {
          "name": "14 - CSV Negative Tests Copy",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const name = pm.iterationData.get(\"name\");\r",
                  "const omitName = pm.iterationData.get(\"omit_name\");\r",
                  "\r",
                  "const payload = {\r",
                  "    category: pm.iterationData.get(\"category\"),\r",
                  "    price: Number(pm.iterationData.get(\"price\")),\r",
                  "    available: pm.iterationData.get(\"available\") === \"true\"\r",
                  "};\r",
                  "\r",
                  "if (omitName !== \"true\" && name) {\r",
                  "    payload.name = name;\r",
                  "}\r",
                  "\r",
                  "pm.request.body.update({\r",
                  "    mode: \"raw\",\r",
                  "    raw: JSON.stringify(payload),\r",
                  "    options: {\r",
                  "        raw: {\r",
                  "            language: \"json\"\r",
                  "        }\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expected = Number(pm.iterationData.get(\"expected_status\"));\r",
                  "const caseName = pm.iterationData.get(\"case_name\");\r",
                  "\r",
                  "pm.test(caseName + \" - Expected HTTP \" + expected, function () {\r",
                  "    pm.expect(pm.response.code).to.eql(expected);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"Mon thu\",\r\n    \"category\": \"com\",\r\n    \"price\": 30000,\r\n    \"available\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu-items"
              ]
            }
          },
          "response": []
        }
      ]
